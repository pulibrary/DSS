<%= form_for(country) do |f| %>
  <% if country.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(country.errors.count, "error") %> prohibited this country from being saved:</h2>

      <ul>
      <% country.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div class="field lux">
    <lux-input-multiselect :items="<%= @regions.to_json %>"
      <% if @current_regions %>:default-values="<%= @current_regions&.to_json %>"<% end %>
      label="Regions"
      selected-items-label="Selected regions"
      none-selected-label="No regions selected">
      <template v-slot:hidden-input="{ selectedItems }">
        <input v-for="item in selectedItems" type="hidden" name="country[region_ids][]" :value="item.id"></input>
      </template>
    </lux-input-multiselect>
  </div>

  <div class="field">
    <%= f.label :key_term_id %>
    <%= f.number_field :key_term_id %>
  </div>

  <div class="form-actions">
    <%= f.submit %>
  </div>
<% end %>
