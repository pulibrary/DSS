<h1>Countries</h1>

<div class="lux admin-controls">
  <lux-hyperlink href="<%= new_country_path %>" variation="button solid">Add New Country</lux-hyperlink>
  <lux-hyperlink href="/merge_countries" variation="button outline" size="small">Merge Countries</lux-hyperlink>
</div>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Key term</th>
      <th>Number of Resources</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @countries.each do |country| %>
      <tr>
        <td><%= country.name %></td>
        <td><%= country.key_term_id %></td>
        <td><%= link_to 'Show', country %></td>
        <td><%= link_to 'Edit', edit_country_path(country) %></td>
        <td><%= link_to 'Destroy', country, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
